<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dalil_bg"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/dalil_footer"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- HEADER: App Identity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dalil_app_title"
                    android:textColor="@color/dalil_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dalil_subtitle"
                    android:textColor="@color/dalil_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- SEARCH BAR -->
            <LinearLayout
                android:id="@+id/dalil_search_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/dalil_search_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/dalil_ic_search"
                    android:contentDescription="@string/dalil_search_hint"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/dalil_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/dalil_search_hint"
                    android:textColorHint="@color/dalil_hint"
                    android:textColor="@color/dalil_text_primary"
                    android:textSize="14sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textAlignment="viewStart" />
            </LinearLayout>

            <!-- NEAR ME BUTTON -->
            <LinearLayout
                android:id="@+id/dalil_near_me_btn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/dalil_near_me_bg"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/dalil_ic_near_me"
                    android:contentDescription="@string/dalil_near_me"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dalil_near_me"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CATEGORY GRID: 3 columns x 2 rows -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="التصنيفات"
                android:textColor="@color/dalil_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:useDefaultMargins="true"
                android:alignmentMode="alignBounds">

                <!-- Row 1 -->
                <!-- Restaurants -->
                <LinearLayout
                    android:id="@+id/dalil_cat_restaurant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/dalil_card_restaurant_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/dalil_ic_restaurant"
                        android:contentDescription="@string/dalil_restaurants" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dalil_restaurants"
                        android:textColor="@color/dalil_text_primary"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Pharmacies -->
                <LinearLayout
                    android:id="@+id/dalil_cat_pharmacy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/dalil_card_pharmacy_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/dalil_ic_pharmacy"
                        android:contentDescription="@string/dalil_pharmacies" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dalil_pharmacies"
                        android:textColor="@color/dalil_text_primary"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Hospitals -->
                <LinearLayout
                    android:id="@+id/dalil_cat_hospital"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/dalil_card_hospital_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/dalil_ic_hospital"
                        android:contentDescription="@string/dalil_hospitals" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dalil_hospitals"
                        android:textColor="@color/dalil_text_primary"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2 -->
                <!-- Fuel -->
                <LinearLayout
                    android:id="@+id/dalil_cat_fuel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/dalil_card_fuel_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/dalil_ic_fuel"
                        android:contentDescription="@string/dalil_fuel" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dalil_fuel"
                        android:textColor="@color/dalil_text_primary"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Workshops -->
                <LinearLayout
                    android:id="@+id/dalil_cat_workshop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/dalil_card_workshop_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/dalil_ic_workshop"
                        android:contentDescription="@string/dalil_workshops" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dalil_workshops"
                        android:textColor="@color/dalil_text_primary"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Stores -->
                <LinearLayout
                    android:id="@+id/dalil_cat_store"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="@drawable/dalil_card_store_bg"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/dalil_ic_store"
                        android:contentDescription="@string/dalil_stores" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dalil_stores"
                        android:textColor="@color/dalil_text_primary"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        android:textStyle="bold" />
                </LinearLayout>
            </GridLayout>

            <!-- POPULAR PLACES SECTION -->
            <TextView
                android:id="@+id/dalil_popular_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dalil_popular_places"
                android:textColor="@color/dalil_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:paddingBottom="8dp" />

            <!-- Popular Place Card 1 -->
            <LinearLayout
                android:id="@+id/dalil_place_card_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dalil_place_card_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مطعم السعيدة"
                    android:textColor="@color/dalil_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مطعم · صنعاء"
                    android:textColor="@color/dalil_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ ٤.٥ · ١٢٣ تقييم"
                    android:textColor="@color/dalil_accent"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Popular Place Card 2 -->
            <LinearLayout
                android:id="@+id/dalil_place_card_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dalil_place_card_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="صيدلية النور"
                    android:textColor="@color/dalil_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="صيدلية · عدن"
                    android:textColor="@color/dalil_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ ٤.٧ · ٨٩ تقييم"
                    android:textColor="@color/dalil_accent"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Popular Place Card 3 -->
            <LinearLayout
                android:id="@+id/dalil_place_card_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dalil_place_card_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مستشفى الأمل"
                    android:textColor="@color/dalil_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مستشفى · تعز"
                    android:textColor="@color/dalil_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ ٤.٣ · ٥٦ تقييم"
                    android:textColor="@color/dalil_accent"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- FOOTER -->
    <LinearLayout
        android:id="@+id/dalil_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/dalil_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dalil_footer_credit"
            android:textColor="@color/dalil_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>