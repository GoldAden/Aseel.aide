<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hawsa_bg_dark"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- ════════════════════════════════════════════ -->
        <!--  HEADER: Logo + Title + Subtitle            -->
        <!-- ════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <!-- App Icon -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/hawsa_app_title" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الحسوة ماجلان"
                    android:textColor="@color/hawsa_gold"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/tv_designer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aseel.aide Developer Edition"
                    android:textColor="#667799"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.05" />
            </LinearLayout>
        </LinearLayout>

        <!-- Version badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v2.0  •  Dev Build"
            android:textColor="#445577"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- ════════════════════════════════════════════ -->
        <!--  HERO SECTION: Glassmorphism Map Card       -->
        <!-- ════════════════════════════════════════════ -->
        <RelativeLayout
            android:id="@+id/card_map"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/hawsa_hero_bg"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- Gradient overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hawsa_card_bg_rounded" />

            <!-- Map icon -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/hawsa_icon_map"
                android:alpha="0.7"
                android:contentDescription="Map" />

            <!-- Text overlay -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:paddingStart="20dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الخريطة"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowDy="2"
                    android:shadowRadius="4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="استكشف العالم بخرائط تفاعلية"
                    android:textColor="#BBDDFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:alpha="0.85" />
            </LinearLayout>

            <!-- Live tag -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:background="#1AFFD700"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:text="● LIVE"
                android:textColor="@color/hawsa_gold"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </RelativeLayout>

        <!-- ════════════════════════════════════════════ -->
        <!--  2×2 FEATURE GRID                           -->
        <!-- ════════════════════════════════════════════ -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false"
            android:alignmentMode="alignBounds"
            android:columnOrderPreserved="false">

            <!-- ──── TIDES CARD ──── -->
            <LinearLayout
                android:id="@+id/card_tides"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="7dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/hawsa_accent_tide"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/hawsa_icon_tide"
                    android:contentDescription="Tides" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المد والجزر"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بيانات المد اليومية"
                    android:textColor="#6699BB"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ──── MOON CARD ──── -->
            <LinearLayout
                android:id="@+id/card_moon"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_marginStart="7dp"
                android:layout_marginBottom="7dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/hawsa_accent_moon"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/hawsa_icon_moon"
                    android:contentDescription="Moon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="القمر"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أطوار القمر والرؤية"
                    android:textColor="#7788AA"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ──── COMPASS CARD ──── -->
            <LinearLayout
                android:id="@+id/card_compass"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_marginEnd="7dp"
                android:layout_marginTop="7dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/hawsa_accent_compass"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/hawsa_icon_compass"
                    android:contentDescription="Compass" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="البوصلة"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اتجاه الشمال والقبلة"
                    android:textColor="#AA9966"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ──── SETTINGS/DEV CARD ──── -->
            <LinearLayout
                android:id="@+id/card_dev"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_marginStart="7dp"
                android:layout_marginTop="7dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/hawsa_card_bg_rounded"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/hawsa_icon_circle"
                    android:alpha="0.6"
                    android:contentDescription="Dev" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المطور"
                    android:textColor="@color/hawsa_gold"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aseel.aide  •  &lt;/&gt;"
                    android:textColor="#556677"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </GridLayout>

        <!-- ════════════════════════════════════════════ -->
        <!--  FOOTER: Status strip                      -->
        <!-- ════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="#334455" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حرّك العالم من راحة يدك"
                android:textColor="#445566"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="#334455" />
        </LinearLayout>

        <!-- System info dev strip -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="OsmAnd+ Nightly  ▎  API 34  ▎  arm64-v8a  ▎  DEV"
            android:textColor="#2A3A4A"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:paddingBottom="12dp" />

    </LinearLayout>
</ScrollView>
