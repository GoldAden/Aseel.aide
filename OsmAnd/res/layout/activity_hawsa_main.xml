<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628"
    android:fitsSystemWindows="true">

    <!-- Hero Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.35"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- App Icon/Image -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/hawsa_majellan_fg"
            android:scaleType="fitCenter"
            android:layout_marginBottom="12dp" />

        <!-- App Title -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الحسوة ماجلان"
            android:textSize="26sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="دليلك للبحر والبر"
            android:textSize="14sp"
            android:textColor="#D8E4EF"
            android:alpha="0.8"
            android:layout_marginBottom="8dp" />

        <!-- Gold Divider -->
        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:background="#FFD700"
            android:alpha="0.7" />

    </LinearLayout>

    <!-- Navigation Cards Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.55"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Row 1: Map + Tides -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Map Card -->
            <LinearLayout
                android:id="@+id/card_map"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#122B46"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/hawsa_icon_circle" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/hawsa_icon_map"
                    android:layout_marginTop="-31dp"
                    android:layout_gravity="center"
                    android:tint="#FFD700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الخريطة"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تصفح الخرائط البحرية"
                    android:textSize="10sp"
                    android:textColor="#D8E4EF"
                    android:alpha="0.6"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Tides Card -->
            <LinearLayout
                android:id="@+id/card_tides"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#122B46"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/hawsa_icon_circle" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/hawsa_icon_tide"
                    android:layout_marginTop="-31dp"
                    android:layout_gravity="center"
                    android:tint="#FFD700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المد والجزر"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="حالة المد والجزر"
                    android:textSize="10sp"
                    android:textColor="#D8E4EF"
                    android:alpha="0.6"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Row 2: Moon + Compass -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Moon Card -->
            <LinearLayout
                android:id="@+id/card_moon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#122B46"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/hawsa_icon_circle" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/hawsa_icon_moon"
                    android:layout_marginTop="-31dp"
                    android:layout_gravity="center"
                    android:tint="#FFD700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="القمر"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أطوار القمر والهلال"
                    android:textSize="10sp"
                    android:textColor="#D8E4EF"
                    android:alpha="0.6"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Compass Card -->
            <LinearLayout
                android:id="@+id/card_compass"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#122B46"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <View
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/hawsa_icon_circle" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/hawsa_icon_compass"
                    android:layout_marginTop="-31dp"
                    android:layout_gravity="center"
                    android:tint="#FFD700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="البوصلة والقبلة"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اتجاه القبلة والبوصلة"
                    android:textSize="10sp"
                    android:textColor="#D8E4EF"
                    android:alpha="0.6"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Footer Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.10"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <!-- Designer Credit Only -->
        <TextView
            android:id="@+id/tv_designer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تم تصميم هذا التطبيق من قبل أصيل صادق"
            android:textSize="12sp"
            android:textColor="#D8E4EF"
            android:alpha="0.7" />

    </LinearLayout>

</LinearLayout>