<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hawsa_main_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:layoutDirection="rtl">

        <!-- ========================= -->
        <!-- Modern Header -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Logo -->

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/hawsa_logo_background"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="center"
                    android:src="@drawable/hawsa_magellan_fg"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/hawsa_app_title" />

            </FrameLayout>

            <!-- App title -->

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hawsa_app_title"
                android:textColor="#FFD700"
                android:textSize="30sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="دليلك للملاحة واستكشاف البر والبحر"
                android:textColor="#D8E4EF"
                android:textSize="14sp"
                android:gravity="center"
                android:alpha="0.9" />

            <!-- Gold divider -->

            <View
                android:layout_width="70dp"
                android:layout_height="2dp"
                android:layout_marginTop="14dp"
                android:background="#FFD700" />

        </LinearLayout>

        <!-- ========================= -->
        <!-- Section title -->
        <!-- ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="أدوات الحسوة ماجلان"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="right" />

        <!-- ========================= -->
        <!-- Row 1 -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- MAP -->

            <androidx.cardview.widget.CardView
                android:id="@+id/card_map"
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp"
                app:cardBackgroundColor="#122B46">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/hawsa_icon_circle">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/hawsa_icon_map"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/hawsa_map" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/hawsa_map"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="7dp"
                        android:background="#FFD700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- TIDE -->

            <androidx.cardview.widget.CardView
                android:id="@+id/card_tide"
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp"
                app:cardBackgroundColor="#122B46">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/hawsa_icon_circle">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/hawsa_icon_tide"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/hawsa_tide" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/hawsa_tide"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="7dp"
                        android:background="#FFD700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ========================= -->
        <!-- Row 2 -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="12dp">

            <!-- MOON -->

            <androidx.cardview.widget.CardView
                android:id="@+id/card_moon"
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp"
                app:cardBackgroundColor="#122B46">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/hawsa_icon_circle">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/hawsa_icon_moon"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/hawsa_moon" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/hawsa_moon"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="7dp"
                        android:background="#FFD700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- COMPASS -->

            <androidx.cardview.widget.CardView
                android:id="@+id/card_compass"
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp"
                app:cardBackgroundColor="#122B46">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/hawsa_icon_circle">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/hawsa_icon_compass"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/hawsa_compass" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/hawsa_compass"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="7dp"
                        android:background="#FFD700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ========================= -->
        <!-- Designer -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/tv_designer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="4dp"
            android:text="@string/hawsa_designer_credit"
            android:textColor="#9FB1C2"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>
