<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A1628"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- ===== HERO SECTION ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/hawsa_hero_bg"
        android:padding="24dp"
        android:layout_marginBottom="16dp">

        <!-- App Icon -->
        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/hawsa_magellan_fg"
            android:scaleType="fitCenter"
            android:layout_marginBottom="14dp" />

        <!-- App Title -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الحسوة ماجلان"
            android:textSize="28sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="6dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="دليلك البحري الشامل — برًا وبحرًا"
            android:textSize="13sp"
            android:textColor="#A8C4DA"
            android:alpha="0.85" />

        <!-- Gold Divider -->
        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:background="#FFD700"
            android:alpha="0.6"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>

    <!-- ===== NAVIGATION CARDS — 2×2 Grid ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: Map + Tides -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- ── Map Card ── -->
            <LinearLayout
                android:id="@+id/card_map"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:background="@drawable/hawsa_card_bg_rounded"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Accent top bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/hawsa_accent_map" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <!-- Icon circle -->
                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/hawsa_icon_circle_large" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/hawsa_icon_map"
                        android:layout_marginTop="-38dp"
                        android:layout_gravity="center"
                        android:tint="#2196F3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="الخريطة"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تصفح الخرائط البحرية"
                        android:textSize="11sp"
                        android:textColor="#8FACC4"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ── Tides Card ── -->
            <LinearLayout
                android:id="@+id/card_tides"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:background="@drawable/hawsa_card_bg_rounded"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Accent top bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/hawsa_accent_tide" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <!-- Icon circle -->
                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/hawsa_icon_circle_large" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/hawsa_icon_tide"
                        android:layout_marginTop="-38dp"
                        android:layout_gravity="center"
                        android:tint="#009688" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="المد والجزر"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حالة المد والجزر اليومية"
                        android:textSize="11sp"
                        android:textColor="#8FACC4"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Row 2: Moon + Compass -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ── Moon Card ── -->
            <LinearLayout
                android:id="@+id/card_moon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:background="@drawable/hawsa_card_bg_rounded"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Accent top bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/hawsa_accent_moon" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <!-- Icon circle -->
                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/hawsa_icon_circle_large" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/hawsa_icon_moon"
                        android:layout_marginTop="-38dp"
                        android:layout_gravity="center"
                        android:tint="#FF9800" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="القمر"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="أطوار القمر والهلال"
                        android:textSize="11sp"
                        android:textColor="#8FACC4"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ── Compass Card ── -->
            <LinearLayout
                android:id="@+id/card_compass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:background="@drawable/hawsa_card_bg_rounded"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Accent top bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/hawsa_accent_compass" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <!-- Icon circle -->
                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/hawsa_icon_circle_large" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/hawsa_icon_compass"
                        android:layout_marginTop="-38dp"
                        android:layout_gravity="center"
                        android:tint="#FFD700" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="البوصلة والقبلة"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اتجاه القبلة والبوصلة"
                        android:textSize="11sp"
                        android:textColor="#8FACC4"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ===== SPACER ===== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- ===== INFO BANNER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/hawsa_card_bg_rounded"
        android:padding="14dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/hawsa_icon_compass"
            android:tint="#FFD700"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تطبيق ملاحي متكامل للبحارة والمسافرين"
            android:textSize="12sp"
            android:textColor="#A8C4DA" />

    </LinearLayout>

    <!-- ===== FOOTER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_designer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تم تصميم هذا التطبيق من قبل أصيل صادق"
            android:textSize="12sp"
            android:textColor="#6B8BA4"
            android:alpha="0.8" />

    </LinearLayout>

</LinearLayout>

</ScrollView>