<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hawsa_main_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:layoutDirection="rtl">

        <!-- ============ -->
        <!-- Modern Header with Hero Image -->
        <!-- ============ -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#0A1628">

                <!-- Hero Image Area -->
                <ImageView
                    android:id="@+id/iv_hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/hawsa_majellan_fg"
                    android:contentDescription="@string/hawsa_app_title" />

                <!-- App Title Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp">

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hawsa_app_title"
                        android:textColor="#FFD700"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="دليلك للبحر والبر"
                        android:textColor="#D8E4EF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:alpha="0.9" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="10dp"
                        android:background="#FFD700" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ============ -->
        <!-- Section Title -->
        <!-- ============ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="خدمات الملاحة"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="right" />

        <!-- ============ -->
        <!-- Row 1: MAP + TIDE -->
        <!-- ============ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- MAP Card -->

            <androidx.cardview.widget.CardView
                android:id="@+id/card_map"
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp"
                app:cardBackgroundColor="#122B46">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/hawsa_icon_circle">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/hawsa_icon_map"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/hawsa_map" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/hawsa_map"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="7dp"
                        android:background="#FFD700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- TIDE Card -->

            <androidx.cardview.widget.CardView
                android:id="@+id/card_tide"
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp"
                app:cardBackgroundColor="#122B46">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/hawsa_icon_circle">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/hawsa_icon_tide"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/hawsa_tide" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/hawsa_tide"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="7dp"
                        android:background="#FFD700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ============ -->
        <!-- Row 2: MOON + COMPASS -->
        <!-- ============ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="12dp">

            <!-- MOON Card -->

            <androidx.cardview.widget.CardView
                android:id="@+id/card_moon"
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp"
                app:cardBackgroundColor="#122B46">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/hawsa_icon_circle">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/hawsa_icon_moon"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/hawsa_moon" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/hawsa_moon"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="7dp"
                        android:background="#FFD700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- COMPASS/QIBLA Card -->

            <androidx.cardview.widget.CardView
                android:id="@+id/card_compass"
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="7dp"
                app:cardBackgroundColor="#122B46">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/hawsa_icon_circle">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/hawsa_icon_compass"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/hawsa_compass" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/hawsa_compass"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="7dp"
                        android:background="#FFD700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ============ -->
        <!-- Footer -->
        <!-- ============ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تصميم: أسيل صديق"
                android:textColor="#8095A8"
                android:textSize="12sp" />

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#406080" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متاح بدون إنترنت"
                android:textColor="#8095A8"
                android:textSize="12sp" />

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#406080" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textColor="#607080"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>