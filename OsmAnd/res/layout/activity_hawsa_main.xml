<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hawsa_bg_dark"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ═══════════════════════════════════════════ -->
        <!--  HEADER: App Identity Bar                  -->
        <!-- ═══════════════════════════════════════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- App Icon -->
            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/hawsa_app_title" />

            <!-- Title + Subtitle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/iv_app_icon"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الحسوة ماجلان"
                    android:textColor="@color/hawsa_gold"
                    android:textSize="21sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/tv_designer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aseel.aide  ·  Dev Edition"
                    android:textColor="#556688"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Version badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="4dp"
                android:background="@drawable/hawsa_card_dev_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="v2.1"
                android:textColor="#556688"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </RelativeLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!--  HERO: Map Card with dev-style overlay      -->
        <!-- ═══════════════════════════════════════════ -->
        <RelativeLayout
            android:id="@+id/card_map"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/hawsa_card_map_bg"
            android:elevation="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- Top-left LIVE indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/hawsa_card_dev_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#FF4444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" LIVE"
                    android:textColor="#FF6666"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:paddingStart="4dp" />
            </LinearLayout>

            <!-- Top-right map icon -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/hawsa_icon_map"
                android:alpha="0.4"
                android:contentDescription="Map" />

            <!-- Bottom text content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الخريطة"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#66000000"
                    android:shadowDy="2"
                    android:shadowRadius="6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="استكشف العالم بخرائط تفاعلية عالية الدقة"
                    android:textColor="#88AACC"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="4dp" />

                <!-- Dev-style tag row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS"
                        android:textColor="#6699BB"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/hawsa_card_dev_bg"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFFLINE"
                        android:textColor="#6699BB"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:background="@drawable/hawsa_card_dev_bg"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!--  2×2 FEATURE GRID: Modern Dev Cards        -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- ──── TIDES CARD ──── -->
            <LinearLayout
                android:id="@+id/card_tides"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/hawsa_card_tide_bg"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="14dp">

                <!-- Top accent line -->
                <View
                    android:layout_width="30dp"
                    android:layout_height="3dp"
                    android:background="#4DB6AC"
                    android:layout_marginBottom="14dp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/hawsa_icon_tide"
                    android:contentDescription="Tides" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المد والجزر"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بيانات المد اليومية"
                    android:textColor="#80CBC4"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- ──── MOON CARD ──── -->
            <LinearLayout
                android:id="@+id/card_moon"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/hawsa_card_moon_bg"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="14dp">

                <!-- Top accent line -->
                <View
                    android:layout_width="30dp"
                    android:layout_height="3dp"
                    android:background="#FF9800"
                    android:layout_marginBottom="14dp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/hawsa_icon_moon"
                    android:contentDescription="Moon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="القمر"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أطوار القمر والرؤية"
                    android:textColor="#CE93D8"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ──── COMPASS CARD ──── -->
            <LinearLayout
                android:id="@+id/card_compass"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/hawsa_card_compass_bg"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="14dp">

                <!-- Top accent line -->
                <View
                    android:layout_width="30dp"
                    android:layout_height="3dp"
                    android:background="#FFD700"
                    android:layout_marginBottom="14dp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/hawsa_icon_compass"
                    android:contentDescription="Compass" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="البوصلة"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اتجاه الشمال والقبلة"
                    android:textColor="#FFE082"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- ──── DEV CARD ──── -->
            <LinearLayout
                android:id="@+id/card_dev"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/hawsa_card_dev_bg"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="14dp">

                <!-- Top accent line -->
                <View
                    android:layout_width="30dp"
                    android:layout_height="3dp"
                    android:background="#334466"
                    android:layout_marginBottom="14dp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/hawsa_icon_circle"
                    android:alpha="0.5"
                    android:contentDescription="Dev" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المطور"
                    android:textColor="@color/hawsa_gold"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aseel.aide  &lt;/&gt;"
                    android:textColor="#445566"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!--  FOOTER: Dev-style system strip            -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="20dp">

            <View
                android:layout_width="280dp"
                android:layout_height="0.5dp"
                android:background="#223344"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حرّك العالم من راحة يدك"
                android:textColor="#3A4D66"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OsmAnd+ Nightly  ·  API 34  ·  arm64-v8a  ·  DEV"
                android:textColor="#1E2D3D"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
