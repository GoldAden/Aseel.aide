<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Full lit circle base -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#EEEECC" />
            <stroke android:width="2dp" android:color="#555577" />
            <size android:width="100dp" android:height="100dp" />
        </shape>
    </item>
    <!-- Dark right crescent overlay -->
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="44dp"
        android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="#222244" />
            <size android:width="52dp" android:height="88dp" />
        </shape>
    </item>
</layer-list>
