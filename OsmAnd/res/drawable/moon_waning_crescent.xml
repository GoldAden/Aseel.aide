<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark base circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#222244" />
            <stroke android:width="2dp" android:color="#555577" />
            <size android:width="100dp" android:height="100dp" />
        </shape>
    </item>
    <!-- Lit left crescent -->
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="44dp">
        <shape android:shape="oval">
            <solid android:color="#EEEECC" />
            <size android:width="52dp" android:height="92dp" />
        </shape>
    </item>
    <!-- Dark overlay to shape crescent -->
    <item
        android:top="8dp"
        android:bottom="8dp"
        android:left="8dp"
        android:right="50dp">
        <shape android:shape="oval">
            <solid android:color="#222244" />
            <size android:width="42dp" android:height="84dp" />
        </shape>
    </item>
</layer-list>
